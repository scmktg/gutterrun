---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SuburbDays from '../components/SuburbDays.astro';
import WhyOneSeventyFive from '../components/WhyOneSeventyFive.astro';
import WhatYouGet from '../components/WhatYouGet.astro';
import BookingSection from '../components/BookingSection.astro';
import Footer from '../components/Footer.astro';

// Server-render so suburb cards + the booking form's date dropdown always
// show fresh availability. Cheap (the page is tiny) and avoids a flash of
// stale prerendered dates.
export const prerender = false;
---

<Layout>
  <Hero />
  <HowItWorks />
  <SuburbDays />
  <WhyOneSeventyFive />
  <WhatYouGet />
  <BookingSection />
  <Footer />
</Layout>

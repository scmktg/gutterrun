---
const steps = [
  {
    n: '1',
    title: "Find your suburb's day",
    body: 'Tuggerah on Mondays, Wyong on Tuesdays, The Entrance on Wednesdays. We come to your suburb once a week.',
  },
  {
    n: '2',
    title: 'Book one of five spots',
    body: 'Each day takes five houses, no more. Pick the next available date or a future week.',
  },
  {
    n: '3',
    title: 'We arrive on the day',
    body: 'Single-storey gutters cleared, downpipes checked, debris bagged and gone.',
  },
  {
    n: '4',
    title: 'Proof in your inbox',
    body: 'Photo album and bushfire-ready check sent within 24 hours of the clean.',
  },
];
---

<section id="how-it-works" class="bg-white text-ink">
  <div class="mx-auto w-full max-w-[1280px] px-6 md:px-10 py-24 md:py-32">
    <p class="eyebrow text-ink/60">How it works</p>
    <h2 class="mt-6 md:mt-8 font-display font-normal text-headline text-green-deep max-w-3xl">
      Tight routes, fair prices.
    </h2>

    <ol class="mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-14 md:gap-y-20">
      {
        steps.map((step) => (
          <li class="flex gap-6 md:gap-8">
            <div
              class="font-display italic font-normal text-green-matte leading-none shrink-0"
              style="font-size: clamp(3.5rem, 7vw, 5.5rem);"
              aria-hidden="true"
            >
              {step.n}
            </div>
            <div class="pt-2 md:pt-3">
              <h3 class="font-display font-normal text-2xl md:text-3xl text-green-deep tracking-tight">
                {step.title}
              </h3>
              <p class="mt-3 md:mt-4 font-sans text-ink/75 leading-relaxed max-w-md">
                {step.body}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

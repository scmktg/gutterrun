---
const items = [
  {
    title: 'Before and after photos',
    body: 'Every job documented. Photo album sent by SMS within 24 hours.',
  },
  {
    title: 'Bushfire-ready check',
    body: 'Visual assessment of ember risk and overhanging vegetation noted in your report.',
  },
  {
    title: 'Fully insured, locally owned',
    body: '$10M public liability. Single-storey specialists only. Central Coast based.',
  },
];
---

<section id="whats-included" class="bg-green-tint text-ink">
  <div class="mx-auto w-full max-w-[1280px] px-6 md:px-10 py-24 md:py-32">
    <p class="eyebrow text-ink/60">What's included</p>
    <h2 class="mt-6 md:mt-8 font-display font-normal text-headline text-green-deep max-w-3xl">
      Proof, not promises.
    </h2>

    <div class="mt-14 md:mt-20 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16">
      {
        items.map((item) => (
          <div>
            <h3 class="font-display font-normal text-2xl md:text-3xl text-green-deep tracking-tight">
              {item.title}
            </h3>
            <p class="mt-4 md:mt-5 font-sans text-ink/75 leading-relaxed max-w-md">
              {item.body}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Photo strip — placeholder slots for real before/after photography -->
    <div class="mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-4 gap-px bg-hairline border border-hairline">
      <!-- TODO: before/after gutter photos go here (slot 1 — before) -->
      <div class="aspect-[4/5] bg-white relative">
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="eyebrow text-ink/35">Before</span>
        </div>
      </div>
      <!-- TODO: before/after gutter photos go here (slot 2 — after) -->
      <div class="aspect-[4/5] bg-white relative">
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="eyebrow text-ink/35">After</span>
        </div>
      </div>
      <!-- TODO: before/after gutter photos go here (slot 3 — downpipe) -->
      <div class="aspect-[4/5] bg-white relative">
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="eyebrow text-ink/35">Downpipe</span>
        </div>
      </div>
      <!-- TODO: before/after gutter photos go here (slot 4 — debris) -->
      <div class="aspect-[4/5] bg-white relative">
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="eyebrow text-ink/35">Debris removed</span>
        </div>
      </div>
    </div>
  </div>
</section>
